{
  "name": "dsh-deepseek-chat",
  "version": "0.2.9",
  "description": "CHAT / HARNESS mode switcher for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingxingbk-git/dsh-deepseek-chat.git"
  },
  "homepage": "https://github.com/xingxingbk-git/dsh-deepseek-chat#readme",
  "bugs": {
    "url": "https://github.com/xingxingbk-git/dsh-deepseek-chat/issues"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "chat",
    "dsh-plugin"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.0-rc.2 || >=0.2.1-rc.1 <0.2.2-0"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "assets/icon.svg",
    "locale"
  ],
  "scripts": {
    "build:plugin": "node ./scripts/build.mjs",
    "release:prepare": "node ./scripts/build.mjs && node ./scripts/check-distribution.mjs",
    "check:distribution": "node ./scripts/check-distribution.mjs",
    "check:compatibility": "node ./scripts/check-compatibility.mjs",
    "check:shell-ui": "node ./scripts/check-shell-ui-browser.mjs",
    "check:window-contracts": "node ./scripts/check-window-contracts.mjs",
    "check:window-recognition": "node ./scripts/check-window-recognition-browser.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ./scripts/test.mjs",
    "preview": "node ./scripts/preview.mjs",
    "check:artifact": "node ./scripts/check-artifact.mjs",
    "check:git-install": "node ./scripts/check-git-install.mjs",
    "package:plugin": "pnpm release:prepare && pnpm pack --pack-destination ./artifacts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2 || >=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2 || >=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/dsh-typert-registry": "0.2.0-rc.2 || >=0.2.1-rc.1 <0.2.2-0",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-group": "1.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar-browser": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.3",
    "@deepseek-ai/dsh-deepseek-account": "0.2.1-rc.3",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "24.0.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "semver": "7.8.5",
    "typescript": "5.8.3"
  },
  "icon": "./assets/icon.svg"
}
